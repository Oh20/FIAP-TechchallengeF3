// =============================================================================
// ToggleMaster — Pipeline DevSecOps (Tech Challenge Fase 3)
// =============================================================================
//
// Ordem das etapas segue o requisito do desafio: "se uma vulnerabilidade
// CRÍTICA for encontrada, o pipeline deve falhar e NÃO PROSSEGUIR". Por isso o
// Quality Gate (etapa 7) roda ANTES do push ao ACR (etapa 8) — imagem
// reprovada nunca chega ao registry.
//
// Autenticação no Azure: usa a App Registration (service principal) direto no
// `docker login` do ACR. Não há `az login`, porque cada `docker run --rm` é um
// container novo e a sessão do az CLI não sobrevive entre eles.
//
// Requisitos do agente Jenkins: apenas Docker e Git. Toda ferramenta roda em
// container.
//
// Plugins: Pipeline, Pipeline Utility Steps (readJSON/writeJSON), Credentials
// Binding, Timestamper, Workspace Cleanup.
//
// Credenciais esperadas no Jenkins:
//   azure-devops-pat        Username/Password  — PAT do Azure DevOps (clones e push GitOps)
//   azure-service-principal Username/Password  — App Registration: appId / client secret
//   defectdojo-api-key      Secret text        — token da API do DefectDojo
//   cosign-key / cosign-password  (opcional)   — só se ASSINAR_IMAGENS=true
// =============================================================================

// --- Catálogo dos microsserviços -------------------------------------------
// Um único clone do repositório da aplicação atende todos: os serviços ficam
// em <clone>/app/<nome>.

def servicos() {
    return [
        [nome: 'auth-service',       linguagem: 'go'],
        [nome: 'evaluation-service', linguagem: 'go'],
        [nome: 'flag-service',       linguagem: 'python'],
        [nome: 'targeting-service',  linguagem: 'python'],
        [nome: 'analytics-service',  linguagem: 'python'],
    ]
}

// --- Helpers ----------------------------------------------------------------

// Conta achados de uma severidade no engagement deste build.
// Usa o campo `count` da API: evita o problema de paginação (a API devolve
// 25 resultados por página, então contar `results` subestima o total).
def contarAchados(String severidade) {
    def resposta = ''
    withEnv(["DD_SEVERIDADE=${severidade}"]) {
        resposta = sh(
            script: '''
                curl -s -G "${DEFECTDOJO_URL}/api/v2/findings/" \
                    -H "Authorization: Token ${DEFECTDOJO_KEY}" \
                    --data-urlencode "test__engagement__name=Build #${BUILD_NUMBER}" \
                    --data-urlencode "active=true" \
                    --data-urlencode "duplicate=false" \
                    --data-urlencode "severity=${DD_SEVERIDADE}" \
                    --data-urlencode "limit=1"
            ''',
            returnStdout: true
        ).trim()
    }

    if (!resposta) {
        return null
    }

    try {
        return readJSON(text: resposta).count as Integer
    } catch (ignored) {
        return null
    }
}

// Conta CRITICAL direto nos relatórios do Trivy, sem depender do DefectDojo.
// É o gate que continua funcionando mesmo com o DefectDojo fora do ar.
def contarCriticalNoTrivy() {
    return sh(
        script: '''
            total=0
            for f in "${REPORTS_DIR}"/trivy-sca-*.json "${REPORTS_DIR}"/trivy-image-*.json; do
                [ -f "$f" ] || continue
                n=$(grep -o '"Severity"[[:space:]]*:[[:space:]]*"CRITICAL"' "$f" | wc -l)
                total=$((total + n))
            done
            echo "$total"
        ''',
        returnStdout: true
    ).trim().toInteger()
}

// =============================================================================

pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 90, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30'))
        disableConcurrentBuilds()
    }

    parameters {
        string(
            name: 'ACR_NAME',
            defaultValue: 'acrtogglemasterprod6k07',
            description: 'Nome do Azure Container Registry (só letras e números — o Azure não aceita hífen). Precisa bater com o `terraform output` e com os manifestos do repositório de GitOps.'
        )
        string(
            name: 'AZURE_TENANT_ID',
            defaultValue: '',
            description: 'Tenant ID (Directory ID) da App Registration. Necessário só para o inventário do ACR via az CLI — o push em si não precisa. Vazio = inventário é pulado.'
        )
        string(
            name: 'APP_URL',
            defaultValue: '',
            description: 'URL do ambiente de staging para o DAST (OWASP ZAP). Vazio = etapa de DAST é pulada.'
        )
        booleanParam(
            name: 'FALHAR_EM_CRITICAL',
            defaultValue: true,
            description: 'Reprova o build se houver vulnerabilidade CRÍTICA. É o requisito do desafio — mantenha ligado.'
        )
        booleanParam(
            name: 'FALHAR_EM_HIGH',
            defaultValue: false,
            description: 'Reprova também em HIGH. Comece desligado: as imagens base (debian-slim) trazem HIGHs que exigem um plano de remediação próprio.'
        )
        booleanParam(
            name: 'IGNORAR_SEM_CORRECAO',
            defaultValue: true,
            description: 'Passa --ignore-unfixed ao Trivy: só considera vulnerabilidade que TEM patch disponível. Necessário para o gate ser acionável — hoje debian:bookworm-slim tem 4 CRITICAL e python:3.13-slim tem 3, todas sem correção publicada. Desligue para ver o retrato completo.'
        )
        booleanParam(
            name: 'ASSINAR_IMAGENS',
            defaultValue: false,
            description: 'Assina as imagens com Cosign. Exige as credenciais cosign-key (secret file) e cosign-password (secret text) cadastradas no Jenkins.'
        )
        booleanParam(
            name: 'ATUALIZAR_GITOPS',
            defaultValue: true,
            description: 'Ao final, atualiza a tag da imagem no repositório de GitOps para o ArgoCD sincronizar. Só roda na branch main.'
        )
        choice(
            name: 'AMBIENTE_GITOPS',
            choices: ['prod', 'dev'],
            description: 'Overlay do Kustomize a atualizar. O ArgoCD está apontado para overlays/prod.'
        )
    }

    environment {
        // --- Diretórios de trabalho ---
        SRC_DIR      = "${WORKSPACE}/src"
        APP_SRC_DIR  = "${WORKSPACE}/src/app"
        TF_REPO_DIR  = "${WORKSPACE}/src/terraform"
        GITOPS_DIR   = "${WORKSPACE}/src/gitops"
        REPORTS_DIR  = "${WORKSPACE}/security-reports"

        // --- Repositórios (sem o https://, o esquema é montado junto do PAT) ---
        APP_REPO    = 'dev.azure.com/Oh20Tony/FIAP%20-%20TechChallenge/_git/FIAP%20-%20ToggleMaster%20F3'
        TF_REPO     = 'dev.azure.com/Oh20Tony/FIAP%20-%20TechChallenge/_git/terraform%20-%20F3'
        GITOPS_REPO = 'dev.azure.com/Oh20Tony/FIAP%20-%20TechChallenge/_git/TCF3%20-%20K8S'

        // --- Azure ---
        AZURE_RESOURCE_GROUP = 'rg-toggle-master'
        ACR_REGISTRY         = "${params.ACR_NAME}.azurecr.io"

        // Flag repassada a todas as varreduras do Trivy, para que o relatório
        // e o Quality Gate contem exatamente o mesmo conjunto de achados.
        TRIVY_FIX_FLAG = "${params.IGNORAR_SEM_CORRECAO ? '--ignore-unfixed' : ''}"

        // --- OWASP DefectDojo ---
        DEFECTDOJO_URL = 'http://defectdojo.local:8080'
        DEFECTDOJO_KEY = credentials('defectdojo-api-key')

        PROTECTED_BRANCH = 'main'
    }

    stages {

        // =====================================================================
        // ETAPA 0: PREPARAÇÃO & CHECKOUT
        // =====================================================================
        // Um clone por repositório. A versão anterior clonava o MESMO repo da
        // aplicação cinco vezes (uma por serviço), o que multiplicava por 5 os
        // achados do Gitleaks/Trivy e o tempo de scan.
        stage('0. Preparar Ambiente & Checkout') {
            steps {
                script {
                    sh '''
                        set -eu
                        rm -rf "${SRC_DIR}" "${REPORTS_DIR}"
                        mkdir -p "${SRC_DIR}" "${REPORTS_DIR}"
                        chmod 777 "${REPORTS_DIR}"
                    '''

                    withCredentials([usernamePassword(
                        credentialsId: 'azure-devops-pat',
                        usernameVariable: 'AZ_USER',
                        passwordVariable: 'AZ_PAT'
                    )]) {
                        // Aspas simples de propósito: quem expande é o shell, não
                        // o Groovy. Interpolar segredo em GString vaza o valor no
                        // log e no `Replay` do Jenkins.
                        sh '''
                            set -eu
                            echo "=== Checkout: aplicação ==="
                            git clone --quiet "https://${AZ_USER}:${AZ_PAT}@${APP_REPO}" "${APP_SRC_DIR}"

                            echo "=== Checkout: IaC (Terraform) ==="
                            git clone --quiet "https://${AZ_USER}:${AZ_PAT}@${TF_REPO}" "${TF_REPO_DIR}"

                            echo "=== Checkout: GitOps (manifestos K8s) ==="
                            git clone --quiet "https://${AZ_USER}:${AZ_PAT}@${GITOPS_REPO}" "${GITOPS_DIR}"
                        '''
                    }

                    // Tag da imagem = build + commit curto, como pede o desafio
                    // ("tag do commit hash"). Antes era só o BUILD_NUMBER, que
                    // não permite rastrear a imagem até o código.
                    def sha = sh(
                        script: "git -C '${env.APP_SRC_DIR}' rev-parse --short=7 HEAD",
                        returnStdout: true
                    ).trim()

                    env.GIT_SHA   = sha
                    env.IMAGE_TAG = "${env.BUILD_NUMBER}-${sha}"
                    echo "Tag desta build: ${env.IMAGE_TAG}"

                    // Checagem de branch desatualizada em Pull Request.
                    // SYSTEM_PULLREQUEST_SOURCEBRANCH é variável do Azure
                    // DevOps: no Jenkins ela não existe e, referenciada sem o
                    // prefixo `env.`, derruba o build com MissingPropertyException.
                    def branchPR = env.CHANGE_BRANCH ?: env.SYSTEM_PULLREQUEST_SOURCEBRANCH

                    if (branchPR) {
                        echo "=== Pull Request detectado (${branchPR}): verificando se está atualizada com ${env.PROTECTED_BRANCH} ==="
                        sh '''
                            set -eu
                            cd "${APP_SRC_DIR}"
                            git config user.email "jenkins@ci.local"
                            git config user.name  "Jenkins CI"
                            git fetch --quiet origin "${PROTECTED_BRANCH}"
                            git merge "origin/${PROTECTED_BRANCH}" --no-commit --no-ff \
                                || { echo "ERRO: branch desatualizada em relação à ${PROTECTED_BRANCH}."; exit 1; }
                            git merge --abort 2>/dev/null || true
                        '''
                    } else {
                        echo 'Build direto de branch (não é PR): checagem de merge pulada.'
                    }
                }
            }
        }

        // =====================================================================
        // ETAPA 1: SHIFT-LEFT — SEGREDOS, IaC E DOCKERFILES
        // =====================================================================
        stage('1. Shift-Left: Secrets, IaC & Dockerfiles') {
            parallel {

                // O Gitleaks precisa apontar para a raiz de UM repositório Git.
                // Apontado para um diretório comum ele escaneia 0 commits, loga
                // um erro e ainda assim reporta "no leaks found" com exit 0 —
                // um falso negativo silencioso.
                stage('Gitleaks (Secret Scanning)') {
                    steps {
                        script {
                            def repos = [
                                [alias: 'app',      dir: env.APP_SRC_DIR],
                                [alias: 'terraform', dir: env.TF_REPO_DIR],
                                [alias: 'gitops',   dir: env.GITOPS_DIR],
                            ]

                            repos.each { repo ->
                                echo "=== Gitleaks: ${repo.alias} ==="
                                sh """
                                    docker run --rm \
                                        -v "${repo.dir}:/repo:ro" \
                                        -v "${env.REPORTS_DIR}:/reports" \
                                        zricethezav/gitleaks:latest detect \
                                        --source=/repo \
                                        --report-format=json \
                                        --report-path=/reports/gitleaks-${repo.alias}.json \
                                        --redact \
                                        --exit-code=0
                                """
                            }

                            // Relatório vai para /reports (volume montado). Antes
                            // ia para /path/../security-reports, que resolve para
                            // a RAIZ DO CONTAINER — e sumia junto com o --rm.
                            sh '''
                                total=0
                                for f in "${REPORTS_DIR}"/gitleaks-*.json; do
                                    [ -f "$f" ] || continue
                                    n=$(grep -o '"RuleID"' "$f" | wc -l)
                                    echo "  $(basename "$f"): $n achado(s)"
                                    total=$((total + n))
                                done
                                echo "=== Gitleaks: $total segredo(s) potencial(is) — detalhes no DefectDojo ==="
                            '''
                        }
                    }
                }

                stage('Trivy IaC (Terraform & K8s)') {
                    steps {
                        sh '''
                            docker run --rm \
                                -v "${SRC_DIR}:/src:ro" \
                                -v "${REPORTS_DIR}:/reports" \
                                aquasec/trivy:latest config \
                                --format json \
                                --output /reports/trivy-iac.json \
                                /src
                        '''
                    }
                }

                stage('Hadolint (Dockerfiles)') {
                    steps {
                        sh '''
                            set -eu
                            find "${APP_SRC_DIR}" -name "Dockerfile*" -type f | while read -r df; do
                                nome=$(echo "$df" | sed "s|${APP_SRC_DIR}/||" | tr '/' '_')
                                docker run --rm -i hadolint/hadolint:latest \
                                    hadolint -f json - < "$df" \
                                    > "${REPORTS_DIR}/hadolint-${nome}.json" || true
                            done
                            echo "=== Hadolint: $(ls -1 "${REPORTS_DIR}"/hadolint-*.json 2>/dev/null | wc -l) Dockerfile(s) analisado(s) ==="
                        '''
                    }
                }
            }
        }

        // =====================================================================
        // ETAPA 2: LINTER & SAST
        // =====================================================================
        // O desafio pede explicitamente Linter/Static Analysis (golangci-lint
        // para Go, pylint/flake8 para Python) e SAST (gosec/bandit). O Horusec
        // sozinho não cobria isso — e nem estava rodando: a imagem
        // `horusec/horusec-cli` não existe no Docker Hub (o nome correto é
        // `horuszup/horusec-cli`), e o `|| true` fazia a etapa passar verde
        // sem executar nada.
        stage('2. Linter & SAST') {
            parallel {

                stage('Go: golangci-lint + gosec') {
                    steps {
                        script {
                            servicos().findAll { it.linguagem == 'go' }.each { svc ->
                                echo "=== Lint/SAST Go: ${svc.nome} ==="
                                sh """
                                    docker run --rm \
                                        -v "${env.APP_SRC_DIR}:/src" \
                                        -w "/src/app/${svc.nome}" \
                                        -e GOFLAGS=-mod=mod \
                                        golangci/golangci-lint:latest \
                                        sh -c 'go mod tidy && golangci-lint run --timeout 5m' || true

                                    docker run --rm \
                                        -v "${env.APP_SRC_DIR}:/src" \
                                        -v "${env.REPORTS_DIR}:/reports" \
                                        -w "/src/app/${svc.nome}" \
                                        securego/gosec:latest \
                                        -fmt=json -out=/reports/gosec-${svc.nome}.json -no-fail ./... || true
                                """
                            }
                        }
                    }
                }

                stage('Python: flake8 + bandit') {
                    steps {
                        script {
                            servicos().findAll { it.linguagem == 'python' }.each { svc ->
                                echo "=== Lint/SAST Python: ${svc.nome} ==="
                                sh """
                                    docker run --rm \
                                        -v "${env.APP_SRC_DIR}:/src" \
                                        -v "${env.REPORTS_DIR}:/reports" \
                                        -w "/src/app/${svc.nome}" \
                                        -e PIP_DISABLE_PIP_VERSION_CHECK=1 \
                                        -e PIP_ROOT_USER_ACTION=ignore \
                                        python:3.13-slim \
                                        sh -c '
                                            pip install --quiet --no-cache-dir flake8 bandit
                                            flake8 --max-line-length=120 --exclude=tests . || true
                                            bandit -r . -x ./tests -f json -o /reports/bandit-${svc.nome}.json || true
                                        '
                                """
                            }
                        }
                    }
                }

                stage('Horusec (SAST consolidado)') {
                    steps {
                        // Um único clone => uma única execução (antes eram 5
                        // execuções sobre cópias idênticas do mesmo repositório).
                        sh '''
                            docker run --rm \
                                -v "${APP_SRC_DIR}:/src" \
                                -v "${REPORTS_DIR}:/reports" \
                                horuszup/horusec-cli:latest \
                                horusec start -p /src -o json -O /reports/horusec.json \
                                --disable-docker=true --ignore="**/tests/**,**/*_test.go" || true

                            [ -f "${REPORTS_DIR}/horusec.json" ] \
                                && echo "=== Horusec: relatório gerado ===" \
                                || echo "AVISO: Horusec não gerou relatório."
                        '''
                    }
                }
            }
        }

        // =====================================================================
        // ETAPA 3: SCA — VULNERABILIDADES NAS DEPENDÊNCIAS
        // =====================================================================
        stage('3. SCA (Trivy FS)') {
            steps {
                script {
                    servicos().each { svc ->
                        echo "=== Trivy SCA: ${svc.nome} ==="
                        sh """
                            docker run --rm \
                                -v "${env.APP_SRC_DIR}:/src:ro" \
                                -v "${env.REPORTS_DIR}:/reports" \
                                aquasec/trivy:latest fs \
                                --scanners vuln \
                                ${env.TRIVY_FIX_FLAG} \
                                --format json \
                                --output /reports/trivy-sca-${svc.nome}.json \
                                "/src/app/${svc.nome}"
                        """
                    }
                }
            }
        }

        // =====================================================================
        // ETAPA 4: SBOM, BUILD E CONTAINER SCAN
        // =====================================================================
        // Build local apenas. O push só acontece na etapa 8, depois do gate.
        stage('4. SBOM, Build & Container Scan') {
            steps {
                script {
                    echo '=== Gerando SBOM do repositório (CycloneDX + SPDX) ==='
                    sh '''
                        docker run --rm \
                            -v "${APP_SRC_DIR}:/src:ro" -v "${REPORTS_DIR}:/reports" \
                            aquasec/trivy:latest fs --format cyclonedx \
                            --output /reports/sbom-cyclonedx.json /src

                        docker run --rm \
                            -v "${APP_SRC_DIR}:/src:ro" -v "${REPORTS_DIR}:/reports" \
                            aquasec/trivy:latest fs --format spdx-json \
                            --output /reports/sbom-spdx.json /src
                    '''

                    servicos().each { svc ->
                        def imagem = "${env.ACR_REGISTRY}/${svc.nome}:${env.IMAGE_TAG}"
                        def contexto = "${env.APP_SRC_DIR}/app/${svc.nome}"

                        echo "=== Build & Scan: ${imagem} ==="
                        sh """
                            docker build -t ${imagem} -t ${env.ACR_REGISTRY}/${svc.nome}:latest ${contexto}

                            docker run --rm \
                                -v /var/run/docker.sock:/var/run/docker.sock \
                                -v "${env.REPORTS_DIR}:/reports" \
                                aquasec/trivy:latest image \
                                ${env.TRIVY_FIX_FLAG} \
                                --format json \
                                --output /reports/trivy-image-${svc.nome}.json \
                                ${imagem}
                        """
                    }
                }
            }
        }

        // =====================================================================
        // ETAPA 5: DAST (OWASP ZAP)
        // =====================================================================
        // Só roda com APP_URL preenchida. Antes apontava para um placeholder
        // (http://staging.minhaapp.local) que nunca resolveu, e o `|| true`
        // escondia isso.
        stage('5. DAST (OWASP ZAP Baseline)') {
            when {
                expression { return params.APP_URL?.trim() }
            }
            steps {
                sh '''
                    set -eu

                    cat > "${WORKSPACE}/zap-rules.tsv" <<'EOF'
10015	IGNORE	(Recomendações de Insecure P3P Header)
10020	IGNORE	(X-Frame-Options Header Not Set)
10021	IGNORE	(X-Content-Type-Options Header Missing)
10038	WARN	(Content Security Policy Header Not Set)
10096	WARN	(Timestamp Disclosure - Unix)
10037	IGNORE	(Server Leaks Information via HTTP Response Header)
10054	IGNORE	(Cookie without SameSite Attribute)
EOF

                    # A imagem do ZAP roda como uid 1000; sem isso ela não
                    # consegue escrever o relatório no diretório do Jenkins.
                    chmod 777 "${REPORTS_DIR}"

                    docker run --rm \
                        -v "${WORKSPACE}:/zap/src/:rw" \
                        -v "${REPORTS_DIR}:/zap/wrk/:rw" \
                        zaproxy/zap-stable zap-baseline.py \
                        -t "${APP_URL}" \
                        -c /zap/src/zap-rules.tsv \
                        -J zap-report.json || true

                    [ -f "${REPORTS_DIR}/zap-report.json" ] \
                        && echo "=== ZAP: relatório gerado ===" \
                        || echo "AVISO: ZAP não gerou relatório — verifique se ${APP_URL} está acessível a partir do agente."
                '''
            }
        }

        // =====================================================================
        // ETAPA 6: CENTRALIZAÇÃO NO OWASP DEFECTDOJO
        // =====================================================================
        stage('6. Centralização de Achados (DefectDojo)') {
            steps {
                script {
                    // Mapa arquivo -> parser do DefectDojo. Arquivo sem parser
                    // conhecido é PULADO: antes caía no fallback "Trivy Scan" e
                    // o import falhava silenciosamente (o curl não checava HTTP).
                    def parsers = [
                        'gitleaks-'      : 'Gitleaks Scan',
                        'trivy-iac'      : 'Trivy Scan',
                        'trivy-sca-'     : 'Trivy Scan',
                        'trivy-image-'   : 'Trivy Scan',
                        'hadolint-'      : 'Hadolint Dockerfile check',
                        'horusec'        : 'Horusec Scan',
                        'gosec-'         : 'Gosec Scanner',
                        'bandit-'        : 'Bandit Scan',
                        'sbom-cyclonedx' : 'CycloneDX Scan',
                        'zap-report'     : 'ZAP Scan',
                    ]

                    def arquivos = sh(
                        script: 'find "${REPORTS_DIR}" -maxdepth 1 -name "*.json" -type f -size +2c | sort',
                        returnStdout: true
                    ).trim()

                    if (!arquivos) {
                        // `ls *.json` sai com código 2 quando não há match e
                        // derrubava o build aqui. `find` devolve vazio e segue.
                        echo 'AVISO: nenhum relatório para importar.'
                        return
                    }

                    def importados = 0
                    def ignorados = []

                    arquivos.split('\n').each { caminho ->
                        def nome = caminho.tokenize('/').last()
                        def parser = parsers.find { chave, _ -> nome.contains(chave) }?.value

                        if (!parser) {
                            ignorados << nome
                            return
                        }

                        def status = ''
                        withEnv(["DD_ARQUIVO=${caminho}", "DD_PARSER=${parser}"]) {
                            status = sh(
                                script: '''
                                    curl -s -o /dev/null -w "%{http_code}" \
                                        -X POST "${DEFECTDOJO_URL}/api/v2/import-scan/" \
                                        -H "Authorization: Token ${DEFECTDOJO_KEY}" \
                                        -F "scan_type=${DD_PARSER}" \
                                        -F "product_name=toggle-master-f3" \
                                        -F "engagement_name=Build #${BUILD_NUMBER}" \
                                        -F "file=@${DD_ARQUIVO}" \
                                        -F "active=true" \
                                        -F "verified=true" \
                                        -F "close_old_findings=true" \
                                        -F "auto_create_context=true"
                                ''',
                                returnStdout: true
                            ).trim()
                        }

                        // verified=true acima é o que faz o Quality Gate
                        // funcionar: o import do DefectDojo marca os achados
                        // como não-verificados por padrão, e a consulta da
                        // etapa 7 filtrava por verified=true — resultado, o
                        // gate SEMPRE via zero achado e SEMPRE aprovava.

                        if (status.startsWith('2')) {
                            echo "  OK  (${status}) ${nome} -> ${parser}"
                            importados++
                        } else {
                            echo "  FALHA (${status}) ${nome} -> ${parser}"
                        }
                    }

                    echo "=== DefectDojo: ${importados} relatório(s) importado(s) ==="
                    if (ignorados) {
                        echo "Sem parser mapeado (não importados): ${ignorados.join(', ')}"
                    }
                }
            }
        }

        // =====================================================================
        // ETAPA 7: QUALITY GATE  ← ANTES DO PUSH
        // =====================================================================
        // O desafio exige falhar e NÃO PROSSEGUIR. Na versão anterior o gate
        // era a última etapa, depois da imagem já ter sido publicada e assinada
        // no ACR.
        //
        // O gate tem duas fontes: o Trivy local (funciona mesmo com o DefectDojo
        // indisponível) e o DefectDojo (visão consolidada de todas as ferramentas).
        stage('7. Quality Gate') {
            steps {
                script {
                    def criticalTrivy = contarCriticalNoTrivy()
                    echo "Trivy (local)      -> CRITICAL: ${criticalTrivy}"

                    def criticalDojo = contarAchados('Critical')
                    def highDojo     = contarAchados('High')

                    if (criticalDojo == null || highDojo == null) {
                        echo 'AVISO: DefectDojo não respondeu — o gate vai usar apenas os relatórios locais do Trivy.'
                    } else {
                        echo "DefectDojo         -> CRITICAL: ${criticalDojo} | HIGH: ${highDojo}"
                    }

                    def critical = Math.max(criticalTrivy, criticalDojo ?: 0)
                    def high     = highDojo ?: 0

                    def motivos = []
                    if (params.FALHAR_EM_CRITICAL && critical > 0) {
                        motivos << "${critical} vulnerabilidade(s) CRITICAL"
                    }
                    if (params.FALHAR_EM_HIGH && high > 0) {
                        motivos << "${high} vulnerabilidade(s) HIGH"
                    }

                    if (motivos) {
                        error "QUALITY GATE REPROVADO: ${motivos.join(' e ')}. As imagens NÃO foram publicadas no ACR."
                    }

                    echo 'QUALITY GATE APROVADO — liberado para publicar no ACR.'
                }
            }
        }

        // =====================================================================
        // ETAPA 8: PUSH NO AZURE ACR (+ COSIGN)
        // =====================================================================
        // Autenticação pela App Registration direto no `docker login`. O ACR
        // aceita appId/secret de um service principal como usuário/senha —
        // não é preciso `az login`, e some o problema de a sessão do az CLI
        // não sobreviver entre containers `--rm`.
        //
        // A App Registration precisa da role AcrPush no registry:
        //   az role assignment create --assignee <appId> --scope <acrId> --role AcrPush
        stage('8. Push no ACR (App Registration)') {
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: 'azure-service-principal',
                        usernameVariable: 'AZURE_CLIENT_ID',
                        passwordVariable: 'AZURE_CLIENT_SECRET'
                    )]) {
                        sh '''
                            set -eu
                            echo "$AZURE_CLIENT_SECRET" \
                                | docker login "${ACR_REGISTRY}" -u "$AZURE_CLIENT_ID" --password-stdin
                            echo "=== Autenticado no ${ACR_REGISTRY} ==="
                        '''

                        servicos().each { svc ->
                            def imagem = "${env.ACR_REGISTRY}/${svc.nome}:${env.IMAGE_TAG}"
                            echo "=== Push: ${imagem} ==="
                            sh """
                                docker push ${imagem}
                                docker push ${env.ACR_REGISTRY}/${svc.nome}:latest
                            """
                        }

                        if (params.ASSINAR_IMAGENS) {
                            withCredentials([
                                file(credentialsId: 'cosign-key', variable: 'COSIGN_KEY_FILE'),
                                string(credentialsId: 'cosign-password', variable: 'COSIGN_PASSWORD')
                            ]) {
                                servicos().each { svc ->
                                    def imagem = "${env.ACR_REGISTRY}/${svc.nome}:${env.IMAGE_TAG}"

                                    // Cosign assina por DIGEST, não por tag —
                                    // uma tag pode ser reapontada depois da
                                    // assinatura. E os flags de registry são
                                    // --registry-username/--registry-password:
                                    // `cosign sign` não tem -u/-p (era por isso
                                    // que a assinatura nunca acontecia).
                                    withEnv(["IMAGEM=${imagem}"]) {
                                        sh '''
                                            set -eu
                                            DIGEST=$(docker inspect --format='{{index .RepoDigests 0}}' "${IMAGEM}")
                                            echo "Assinando ${DIGEST}"

                                            docker run --rm \
                                                -v "${COSIGN_KEY_FILE}:/keys/cosign.key:ro" \
                                                -e COSIGN_PASSWORD="${COSIGN_PASSWORD}" \
                                                bitnami/cosign:latest sign \
                                                --key /keys/cosign.key \
                                                --registry-username "$AZURE_CLIENT_ID" \
                                                --registry-password "$AZURE_CLIENT_SECRET" \
                                                -y "${DIGEST}"
                                        '''
                                    }
                                }
                            }
                        } else {
                            echo 'Assinatura Cosign desativada (ASSINAR_IMAGENS=false).'
                        }

                        // Inventário do repositório no ACR (opcional).
                        // `az acr repository show-manifests` está deprecado; o
                        // comando atual é `az acr manifest list-metadata`.
                        // Login e consulta rodam no MESMO container: em
                        // containers separados a sessão do az CLI se perde.
                        if (params.AZURE_TENANT_ID?.trim()) {
                            sh '''
                                set +e
                                docker run --rm \
                                    -v "${REPORTS_DIR}:/reports" \
                                    -e AZURE_CLIENT_ID -e AZURE_CLIENT_SECRET \
                                    -e AZURE_TENANT_ID -e ACR_NAME \
                                    mcr.microsoft.com/azure-cli \
                                    bash -c '
                                        az login --service-principal \
                                            -u "$AZURE_CLIENT_ID" -p "$AZURE_CLIENT_SECRET" \
                                            --tenant "$AZURE_TENANT_ID" >/dev/null || exit 0
                                        for svc in auth-service evaluation-service flag-service targeting-service analytics-service; do
                                            az acr manifest list-metadata \
                                                --registry "$ACR_NAME" --name "$svc" -o json \
                                                > "/reports/acr-inventario-$svc.json" 2>/dev/null || true
                                        done
                                    '
                                set -e
                            '''
                        } else {
                            echo 'Inventário do ACR pulado (parâmetro AZURE_TENANT_ID vazio).'
                        }
                    }
                }
            }
        }

        // =====================================================================
        // ETAPA 9: GITOPS — ATUALIZA A TAG PARA O ARGOCD SINCRONIZAR
        // =====================================================================
        // A versão anterior só fazia `echo`. Aqui a tag da imagem é gravada no
        // kustomization.yaml do overlay e commitada — é o gatilho do ArgoCD,
        // que observa overlays/prod no repositório TCF3 - K8S.
        stage('9. GitOps: atualizar tag da imagem') {
            when {
                allOf {
                    branch 'main'
                    expression { return params.ATUALIZAR_GITOPS }
                }
            }
            steps {
                script {
                    servicos().each { svc ->
                        def dirOverlay = "overlays/${params.AMBIENTE_GITOPS}/${svc.nome}"

                        withEnv([
                            "DIR_OVERLAY=${dirOverlay}",
                            "IMAGEM_NOVA=${env.ACR_REGISTRY}/${svc.nome}",
                            "SERVICO=${svc.nome}"
                        ]) {
                            // `kustomize edit set image` em vez de sed: o campo
                            // `name` do bloco `images:` é o SELETOR (tem de
                            // continuar batendo com a imagem do base/), e o
                            // destino vai em `newName`/`newTag`. Sobrescrever o
                            // `name` faz o Kustomize não casar nada e a tag
                            // continuar em `latest` — silenciosamente.
                            // O comando também é idempotente, então rodar duas
                            // vezes não duplica a entrada.
                            sh '''
                                set -eu
                                cd "${GITOPS_DIR}"

                                if [ ! -f "${DIR_OVERLAY}/kustomization.yaml" ]; then
                                    echo "AVISO: ${DIR_OVERLAY} não existe — ${SERVICO} pulado."
                                    exit 0
                                fi

                                SELETOR=$(awk '/^images:/{f=1;next} f&&/- name:/{sub(/.*name:[ ]*/,"");print;exit}' \
                                    "${DIR_OVERLAY}/kustomization.yaml")

                                if [ -z "$SELETOR" ]; then
                                    echo "AVISO: ${DIR_OVERLAY} não tem bloco images: — ${SERVICO} pulado."
                                    exit 0
                                fi

                                docker run --rm \
                                    -v "${GITOPS_DIR}:/w" -w "/w/${DIR_OVERLAY}" \
                                    registry.k8s.io/kustomize/kustomize:v5.4.3 \
                                    edit set image "${SELETOR}=${IMAGEM_NOVA}:${IMAGE_TAG}"

                                echo "  ${SERVICO}: ${SELETOR} -> ${IMAGEM_NOVA}:${IMAGE_TAG}"
                            '''
                        }
                    }

                    withCredentials([usernamePassword(
                        credentialsId: 'azure-devops-pat',
                        usernameVariable: 'AZ_USER',
                        passwordVariable: 'AZ_PAT'
                    )]) {
                        sh '''
                            set -eu
                            cd "${GITOPS_DIR}"
                            git config user.email "jenkins@ci.local"
                            git config user.name  "Jenkins CI"
                            git add -A

                            if git diff --cached --quiet; then
                                echo "Nenhuma alteração no GitOps — as tags já estavam atualizadas."
                            else
                                git commit -q -m "ci: ToggleMaster ${IMAGE_TAG} (build #${BUILD_NUMBER})"
                                git push --quiet "https://${AZ_USER}:${AZ_PAT}@${GITOPS_REPO}" HEAD:main
                                echo "=== GitOps atualizado. O ArgoCD vai sincronizar automaticamente. ==="
                            fi
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'security-reports/*', allowEmptyArchive: true
        }
        success {
            echo "Pipeline aprovado. Imagens publicadas com a tag ${env.IMAGE_TAG}."
        }
        failure {
            echo 'Pipeline reprovado. Consulte os relatórios em security-reports/ e o engagement deste build no DefectDojo.'
        }
        cleanup {
            // As imagens locais somam vários GB por build no agente.
            sh 'docker image prune -f --filter "until=24h" || true'
            cleanWs deleteDirs: true, notFailBuild: true
        }
    }
}
