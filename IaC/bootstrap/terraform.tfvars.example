# Copie para terraform.tfvars e ajuste.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# Nao coloque client secret aqui - ele entra so por ARM_CLIENT_SECRET.

resource_group_name  = "rg-togglemaster-tfstate"
storage_account_name = "attogglemastertfstate"
container_name       = "tfstate"
location             = "eastus"

# Object ID do App Registration (NAO e o application/client id):
#   az ad sp show --id <application-client-id> --query id -o tsv
#
# Necessario apenas se este bootstrap rodar com outra identidade (seu usuario
# via az login, por exemplo). Se o proprio App Registration executar o
# bootstrap, ele ja recebe a role automaticamente.
#
# Inclua tambem os usuarios da equipe que rodam terraform localmente:
#   az ad signed-in-user show --query id -o tsv
state_contributor_object_ids = [
  # "00000000-0000-0000-0000-000000000000",  # App Registration togglemaster-infra
  # "11111111-1111-1111-1111-111111111111",  # seu usuario
]

# Somente RBAC do Entra ID no state. Se o primeiro apply falhar com
# AuthorizationPermissionMismatch, suba rbac_propagation_delay para "180s"
# antes de recorrer a ligar a chave compartilhada.
shared_access_key_enabled = false
rbac_propagation_delay    = "90s"

# Alternativa a exportar ARM_TENANT_ID / ARM_SUBSCRIPTION_ID:
# tenant_id       = "00000000-0000-0000-0000-000000000000"
# subscription_id = "00000000-0000-0000-0000-000000000000"
